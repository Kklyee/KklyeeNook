{
  "name": "kklyeenook",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "homepage": "https://electron-vite.org",
  "author": "example.com",
  "main": "./out/main/index.mjs",
  "scripts": {
    "sandbox:build": "node scripts/build-windows-sandbox.mjs",
    "sandbox:setup": "pnpm run sandbox:build && node scripts/setup-windows-sandbox.mjs",
    "sandbox:remove-device-grants": "node scripts/setup-windows-sandbox.mjs --remove",
    "predev": "pnpm run sandbox:build",
    "prebuild": "pnpm run sandbox:build",
    "pretest": "pnpm run sandbox:build",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:remote",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run remote:build && pnpm run typecheck && electron-vite build",
    "postinstall": "patch-package && node scripts/bundle-typebox.mjs && electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "db:gen": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "pnpm exec drizzle-kit push",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "remote:dev": "pnpm --filter @kklyeenook/remote dev",
    "remote:build": "pnpm --filter @kklyeenook/remote build",
    "typecheck:remote": "pnpm --filter @kklyeenook/remote typecheck"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.17",
    "@assistant-ui/react-markdown": "0.14.18",
    "@assistant-ui/react-pi": "0.0.21",
    "@assistant-ui/react-streamdown": "0.3.18",
    "@base-ui/react": "1.7.0",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-durable": "1.1.0",
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@hono/node-server": "2.1.1",
    "@huggingface/transformers": "4.3.0",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/client": "2.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "beautiful-mermaid": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.2.6",
    "diff": "9.0.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.9",
    "lucide-react": "1.37.0",
    "officeparser": "8.1.0",
    "pi-ai-legacy": "npm:@earendil-works/pi-ai@0.84.4",
    "pixi.js": "8.20.1",
    "react-shiki": "0.11.1",
    "remark-gfm": "4.0.1",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-shimmer": "0.4.12",
    "typebox": "1.3.30",
    "undici": "8.11.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@kklyeenook/shared": "workspace:*",
    "@kklyeenook/ui": "workspace:*",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "27.0.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "patch-package": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "typebox": "1.3.30",
      "@assistant-ui/core": "0.3.17",
      "@assistant-ui/react": "0.15.17",
      "@assistant-ui/react-markdown": "0.14.18",
      "@assistant-ui/react-pi": "0.0.21",
      "@assistant-ui/react-streamdown": "0.3.18",
      "@assistant-ui/store": "0.3.12",
      "@assistant-ui/tap": "0.9.16",
      "assistant-cloud": "0.1.42",
      "assistant-stream": "0.3.41",
      "react": "19.2.8",
      "react-dom": "19.2.8"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "onnxruntime-node",
      "sharp"
    ]
  }
}
