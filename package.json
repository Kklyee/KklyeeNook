{
  "name": "kklyeenook-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "pretest": "pnpm --filter @kklyeenook/desktop sandbox:build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "pnpm --filter @kklyeenook/agent typecheck && pnpm --filter @kklyeenook/desktop typecheck && pnpm run typecheck:remote && pnpm run typecheck:grove",
    "typecheck:node": "pnpm --filter @kklyeenook/agent typecheck && pnpm --filter @kklyeenook/desktop typecheck:node",
    "typecheck:web": "pnpm --filter @kklyeenook/desktop typecheck:web",
    "dev": "pnpm --filter @kklyeenook/desktop dev",
    "start": "pnpm --filter @kklyeenook/desktop start",
    "build": "pnpm run remote:build && pnpm --filter @kklyeenook/agent typecheck && pnpm --filter @kklyeenook/desktop build",
    "postinstall": "patch-package && node scripts/bundle-typebox.mjs && pnpm --filter @kklyeenook/desktop exec electron-builder install-app-deps",
    "remote:dev": "pnpm --filter @kklyeenook/remote dev",
    "remote:build": "pnpm --filter @kklyeenook/remote build",
    "typecheck:remote": "pnpm --filter @kklyeenook/remote typecheck",
    "typecheck:grove": "pnpm --filter @kklyeenook/grove typecheck",
    "build:unpack": "pnpm run remote:build && pnpm --filter @kklyeenook/desktop build:unpack",
    "build:win": "pnpm run remote:build && pnpm --filter @kklyeenook/desktop build:win",
    "build:mac": "pnpm run remote:build && pnpm --filter @kklyeenook/desktop build:mac",
    "build:linux": "pnpm run remote:build && pnpm --filter @kklyeenook/desktop build:linux",
    "sandbox:build": "pnpm --filter @kklyeenook/desktop sandbox:build",
    "sandbox:setup": "pnpm --filter @kklyeenook/desktop sandbox:setup",
    "sandbox:remove-device-grants": "pnpm --filter @kklyeenook/desktop sandbox:remove-device-grants",
    "db:gen": "pnpm --filter @kklyeenook/agent db:gen",
    "db:migrate": "pnpm --filter @kklyeenook/agent db:migrate",
    "db:push": "pnpm --filter @kklyeenook/agent db:push",
    "db:check": "pnpm --filter @kklyeenook/agent db:check",
    "db:studio": "pnpm --filter @kklyeenook/agent db:studio",
    "test:package": "pnpm --filter @kklyeenook/desktop test:package"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@kklyeenook/shared": "workspace:*",
    "@kklyeenook/ui": "workspace:*",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "27.0.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "patch-package": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "typebox": "1.3.30",
      "@assistant-ui/core": "0.3.17",
      "@assistant-ui/react": "0.15.17",
      "@assistant-ui/react-markdown": "0.14.18",
      "@assistant-ui/react-streamdown": "0.3.18",
      "@assistant-ui/store": "0.3.12",
      "@assistant-ui/tap": "0.9.16",
      "assistant-cloud": "0.1.42",
      "assistant-stream": "0.3.41",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.5"
    },
    "onlyBuiltDependencies": [
      "@vscode/ripgrep",
      "electron",
      "esbuild",
      "onnxruntime-node",
      "sharp"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
