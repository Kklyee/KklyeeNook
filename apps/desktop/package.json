{
  "name": "@kklyeenook/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An Electron application with React and TypeScript",
  "homepage": "https://electron-vite.org",
  "author": "example.com",
  "main": "./out/main/index.mjs",
  "scripts": {
    "sandbox:build": "node scripts/build-windows-sandbox.mjs",
    "sandbox:setup": "pnpm run sandbox:build && node scripts/setup-windows-sandbox.mjs",
    "sandbox:remove-device-grants": "node scripts/setup-windows-sandbox.mjs --remove",
    "predev": "pnpm run sandbox:build",
    "prebuild": "pnpm run sandbox:build",
    "start": "node scripts/run-electron-vite.mjs preview",
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "pnpm run typecheck && electron-vite build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test:package": "node scripts/verify-package.mjs",
    "sandbox:task": "node scripts/setup-windows-sandbox.mjs --install-task",
    "sandbox:task:remove": "node scripts/setup-windows-sandbox.mjs --remove-task"
  },
  "dependencies": {
    "@assistant-ui/react-lexical": "0.2.9",
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@kklyeenook/agent": "workspace:*",
    "@kklyeenook/shared": "workspace:*",
    "@lexical/react": "0.49.0",
    "lexical": "0.49.0",
    "@tanstack/react-virtual": "3.14.18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "39.8.10",
    "electron-vite": "5.0.0",
    "electron-builder": "26.15.3",
    "@assistant-ui/react": "0.15.17",
    "@base-ui/react": "1.7.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.37.0",
    "react-shiki": "0.11.1",
    "tailwindcss": "4.3.3",
    "tw-shimmer": "0.4.12",
    "zustand": "5.0.15",
    "@kklyeenook/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "productName": "kklyeenook"
}
