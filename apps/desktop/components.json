{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/renderer/src/app/styles.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/renderer/src/components",
    "utils": "./src/renderer/src/lib/utils.ts",
    "ui": "@/renderer/src/components/ui",
    "lib": "@/renderer/src/lib",
    "hooks": "@/renderer/src/hooks"
  },
  "iconLibrary": "lucide",
  "registries": {
    "@assistant-ui": "https://r.assistant-ui.com/styles/{style}/{name}.json"
  }
}
